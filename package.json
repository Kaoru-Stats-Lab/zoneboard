{
  "name": "zoneboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "site:pages": "node --experimental-strip-types scripts/write-site-pages.ts",
    "site:football": "npx --yes tsx scripts/write-football-pages.ts",
    "build": "tsc --noEmit && vite build",

    "preview": "vite preview",
    "test:ink": "npx --yes tsx scripts/pieceInk-check.ts",
    "test:i18n-chrome": "npx --yes tsx scripts/i18n-chrome-check.ts",
    "test:file-session": "npx --yes tsx scripts/file-session-check.ts",
    "test:file-library": "npx --yes tsx scripts/file-library-check.ts",
    "test:file-preview": "npx --yes tsx scripts/file-preview-check.ts",
    "test:file-directory": "npx --yes tsx scripts/file-directory-check.ts",
    "test:file-save": "npx --yes tsx scripts/file-save-check.ts",
    "test:file-source-track": "npx --yes tsx scripts/file-source-track-check.ts",
    "test:file-save-as": "npx --yes tsx scripts/file-save-as-check.ts",
    "test:file-new-local": "npx --yes tsx scripts/file-new-local-board-check.ts",
    "test:text-input-locale": "node scripts/text-input-locale-check.mjs",
    "test:canvas-glyph-locale": "node scripts/canvas-glyph-locale-check.mjs",
    "brand:marks": "npx --yes tsx scripts/write-brand-marks.ts",
    "brand:og": "node scripts/raster-og.mjs",
    "brand:motion": "python scripts/export-brand-motion.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "puppeteer": "^25.9.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
